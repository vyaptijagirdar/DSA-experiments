#include <iostream>
#include <vector>
#include <queue>
using namespace std;

class Graph
{
private:
    int vertices;
    vector<int> adj[20];

public:
    Graph()
    {
        vertices = 0;
    }

    void createGraph()
    {
        int edges, source, destination;

        cout << "Enter number of vertices: ";
        cin >> vertices;

        if (vertices <= 0 || vertices > 20)
        {
            cout << "Invalid number of vertices.\n";
            vertices = 0;
            return;
        }

        for (int i = 0; i < 20; i++)
        {
            adj[i].clear();
        }

        cout << "Enter number of edges: ";
        cin >> edges;

        cout << "Enter edges (source destination):\n";

        for (int i = 0; i < edges; i++)
        {
            cout << "Edge " << i + 1 << ": ";
            cin >> source >> destination;

            if (source >= 0 && source < vertices &&
                destination >= 0 && destination < vertices)
            {
                adj[source].push_back(destination);
                adj[destination].push_back(source);
            }
            else
            {
                cout << "Invalid vertex number.\n";
                i--;
            }
        }

        cout << "Graph created successfully.\n";
    }

    void displayGraph()
    {
        if (vertices == 0)
        {
            cout << "Graph is not created.\n";
            return;
        }

        cout << "\nAdjacency List:\n";

        for (int i = 0; i < vertices; i++)
        {
            cout << i << " -> ";

            for (int j : adj[i])
            {
                cout << j << " ";
            }

            cout << endl;
        }
    }

    void BFS(int startUser)
    {
        if (vertices == 0)
        {
            cout << "Graph is not created.\n";
            return;
        }

        if (startUser < 0 || startUser >= vertices)
        {
            cout << "Invalid starting vertex.\n";
            return;
        }

        bool visited[20] = {false};
        queue<int> q;

        visited[startUser] = true;
        q.push(startUser);

        cout << "\nUsers connected level by level:\n";
        cout << "BFS Traversal: ";

        while (!q.empty())
        {
            int currentUser = q.front();
            q.pop();

            cout << currentUser << " ";

            for (int friendUser : adj[currentUser])
            {
                if (!visited[friendUser])
                {
                    visited[friendUser] = true;
                    q.push(friendUser);
                }
            }
        }

        cout << endl;
    }
};

int main()
{
    Graph socialNetwork;
    int choice, startUser;

    do
    {
        cout << "\n===== SOCIAL NETWORK =====\n";
        cout << "1. Create Graph\n";
        cout << "2. Display Adjacency List\n";
        cout << "3. Perform BFS\n";
        cout << "4. Exit\n";

        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice)
        {
            case 1:
                socialNetwork.createGraph();
                break;

            case 2:
                socialNetwork.displayGraph();
                break;

            case 3:
                cout << "Enter starting user: ";
                cin >> startUser;
                socialNetwork.BFS(startUser);
                break;

            case 4:
                cout << "Program terminated.\n";
                break;

            default:
                cout << "Invalid choice.\n";
        }

    } while (choice != 4);

    return 0;
}
