#include <iostream>
#include <vector>
#include <queue>
using namespace std;

class Graph
{
private:
    int vertices;
    vector<int> *adj;

public:
    Graph()
    {
        vertices = 0;
        adj = NULL;
    }

    void CreateGraph()
    {
        if (adj != NULL)
        {
            delete[] adj;
            adj = NULL;
        }

        int edges;

        cout << "Enter number of users: ";
        cin >> vertices;

        if (vertices <= 0)
        {
            cout << "Invalid number of users." << endl;
            vertices = 0;
            return;
        }

        adj = new vector<int>[vertices];

        cout << "Enter number of friendships: ";
        cin >> edges;

        for (int i = 0; i < edges; i++)
        {
            int u, v;

            cout << "Enter friendship (user1 user2): ";
            cin >> u >> v;

            if (u >= 0 && u < vertices &&
                v >= 0 && v < vertices)
            {
                adj[u].push_back(v);
                adj[v].push_back(u);
            }
            else
            {
                cout << "Invalid user number." << endl;
            }
        }

        cout << "Social Network Created Successfully!" << endl;
    }

    void DisplayGraph()
    {
        if (adj == NULL)
        {
            cout << "Create graph first." << endl;
            return;
        }

        cout << "\nAdjacency List:\n";

        for (int i = 0; i < vertices; i++)
        {
            cout << i << " -> ";

            for (int j = 0; j < adj[i].size(); j++)
            {
                cout << adj[i][j] << " ";
            }

            cout << endl;
        }
    }

    void BFS(int startUser)
    {
        if (adj == NULL)
        {
            cout << "Create graph first." << endl;
            return;
        }

        if (startUser < 0 || startUser >= vertices)
        {
            cout << "Invalid starting user." << endl;
            return;
        }

        vector<bool> visited(vertices, false);
        queue<int> q;

        visited[startUser] = true;
        q.push(startUser);

        cout << "\nUsers connected level by level:\n";

        while (!q.empty())
        {
            int currentUser = q.front();
            q.pop();

            cout << currentUser << " ";

            for (int i = 0; i < adj[currentUser].size(); i++)
            {
                int friendUser = adj[currentUser][i];

                if (visited[friendUser] == false)
                {
                    visited[friendUser] = true;
                    q.push(friendUser);
                }
            }
        }

        cout << endl;
    }

    ~Graph()
    {
        delete[] adj;
    }
};

int main()
{
    Graph socialNetwork;
    int choice;

    do
    {
        cout << "\n===== SOCIAL NETWORK =====\n";
        cout << "1. Create Graph\n";
        cout << "2. Display Adjacency List\n";
        cout << "3. Perform BFS\n";
        cout << "4. Exit\n";

        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice)
        {
        case 1:
            socialNetwork.CreateGraph();
            break;

        case 2:
            socialNetwork.DisplayGraph();
            break;

        case 3:
        {
            int startUser;

            cout << "Enter starting user: ";
            cin >> startUser;

            socialNetwork.BFS(startUser);
            break;
        }

        case 4:
            cout << "Program terminated." << endl;
            break;

        default:
            cout << "Invalid choice." << endl;
        }

    } while (choice != 4);

    return 0;
}
